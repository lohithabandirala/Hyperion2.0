# NTRO Gen AI Platform Environment Configuration

APP_ENV=development
API_V1_STR=/api
DATABASE_URL=sqlite:///./ntro.db
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (gemini, openai, groq, mock)
LLM_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
GROQ_API_KEY=

# Security
SECRET_KEY=ntro-super-secret-key-change-in-production-26154
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_FILE_SIZE_MB=50
REQUEST_TIMEOUT_SECONDS=30
STORAGE_PATH=./storage

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
